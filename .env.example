# ArchitectAny AAi - Environment Variable Template
# ============================================================

# App Hosting & Origin
APP_URL="http://localhost:3000"

# Gemini API (Server-Side Only)
GEMINI_API_KEY=""

# PostgreSQL Database Configuration (Server-Side Service Boundary Only)
# CRITICAL SECURITY RULE: Never expose PostgreSQL credentials to browser code.
DATABASE_URL="postgresql://user:password@localhost:5432/architectany_db?sslmode=require"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="architectany_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
